# 打包产物（通过 Releases 发布，不进仓库）
dist/

# 本地账号配置（个人数据，不进仓库、不进场景包）
*.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 技能运行时产生的会话/状态缓存（跑测试或实际使用时会落在技能目录里）
_session_*.json
*.session.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 站点生成物（SKILL.md 副本 + zip 镜像）由 tools/build_site.py 生成，
# 但【必须进 main】：GitCode Pages 直接从 main 的 /site 目录部署，
# 副本不在仓库里 = 站点下载按钮全部失效。site.json 供文本 diff，副本供下载。
# （dist/ 依旧不进仓库，Release 走 Release 附件）
.aqg/

# WorkBuddy 项目记忆目录
.workbuddy/

# 链级 E2E 真出活儿产物（视频/图片体积大，不入库，仅留报告）
tests/_e2e_artifacts/**/
!tests/_e2e_artifacts/chain_e2e_report.json

# 场景台架写在工作目录的输入残留（正经输入在 tests/_scenario_artifacts/<domain>/<skill>/inputs/ 下）
# 防止它污染仓库根目录并干扰 release.py 的「工作区必须干净」检查
/scene_input.json
