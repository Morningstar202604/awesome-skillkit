# 打包产物（通过 Releases 发布，不进仓库）
dist/

# 本地账号配置（个人数据，不进仓库、不进场景包）
*.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 技能运行时产生的会话/状态缓存（跑测试或实际使用时会落在技能目录里）
_session_*.json
*.session.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 站点生成物（SKILL.md 副本 + zip 镜像，由 tools/build_site.py 生成，
# 只随 gh-pages 发布分支走，不进 main）
site/skills/
site/packs/
