from datetime import datetime
from typing import Dict, List, Optional

from fastapi import APIRouter, FastAPI, HTTPException
from pydantic import BaseModel, ConfigDict, Field


class {{ Model }}Base(BaseModel):
    """{{ Model }} 的公共字段，Create / Read 共用。"""

    name: str = Field(..., min_length=1, max_length=100)
    description: Optional[str] = None


class {{ Model }}Create({{ Model }}Base):
    """创建 {{ Model }} 时接收的请求体。"""


class {{ Model }}Update(BaseModel):
    """更新 {{ Model }} 时接收的请求体，字段全部可选（PATCH 语义）。"""

    name: Optional[str] = Field(None, min_length=1, max_length=100)
    description: Optional[str] = None


class {{ Model }}({{ Model }}Base):
    """服务端读模型：在 {{ Model }}Base 之上补充主键与时间戳。"""

    id: int
    created_at: datetime
    updated_at: datetime

    model_config = ConfigDict(from_attributes=True)


class {{ Service }}:
    """{{ Model }} 的内存字典仓储。接入真实数据库时替换本类实现即可。"""

    def __init__(self) -> None:
        self._items: Dict[int, {{ Model }}] = {}
        self._next_id = 1

    def create(self, data: {{ Model }}Create) -> {{ Model }}:
        now = datetime.now()
        item = {{ Model }}(
            id=self._next_id,
            created_at=now,
            updated_at=now,
            **data.model_dump(),
        )
        self._items[item.id] = item
        self._next_id += 1
        return item

    def find_all(self) -> List[{{ Model }}]:
        return list(self._items.values())

    def find_by_id(self, {{ id_param }}: int) -> Optional[{{ Model }}]:
        return self._items.get({{ id_param }})

    def update(self, {{ id_param }}: int, data: {{ Model }}Update) -> Optional[{{ Model }}]:
        item = self._items.get({{ id_param }})
        if item is None:
            return None
        patched = item.model_dump()
        patched.update(data.model_dump(exclude_unset=True))
        patched["updated_at"] = datetime.now()
        self._items[{{ id_param }}] = {{ Model }}(**patched)
        return self._items[{{ id_param }}]

    def delete(self, {{ id_param }}: int) -> bool:
        return self._items.pop({{ id_param }}, None) is not None


router = APIRouter(prefix="/{{ target }}", tags=["{{ target }}"])
service = {{ Service }}()


@router.get("/", response_model=List[{{ Model }}])
async def list_{{ target }}() -> List[{{ Model }}]:
    return service.find_all()


@router.post("/", response_model={{ Model }}, status_code=201)
async def create_{{ target }}(data: {{ Model }}Create) -> {{ Model }}:
    return service.create(data)


@router.get("/{{ id_route }}", response_model={{ Model }})
async def get_{{ target }}({{ id_param }}: int) -> {{ Model }}:
    item = service.find_by_id({{ id_param }})
    if item is None:
        raise HTTPException(status_code=404, detail="{{ Model }} not found")
    return item


@router.put("/{{ id_route }}", response_model={{ Model }})
async def update_{{ target }}({{ id_param }}: int, data: {{ Model }}Update) -> {{ Model }}:
    item = service.update({{ id_param }}, data)
    if item is None:
        raise HTTPException(status_code=404, detail="{{ Model }} not found")
    return item


@router.delete("/{{ id_route }}", status_code=204)
async def delete_{{ target }}({{ id_param }}: int) -> None:
    if not service.delete({{ id_param }}):
        raise HTTPException(status_code=404, detail="{{ Model }} not found")


